rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    function isValidEnrollmentLog(data) {
      return data.keys().hasAll(['startMonth', 'endMonth'])
        && !data.keys().hasAny(['month'])
        && data.startMonth is int && data.startMonth >= 1 && data.startMonth <= 12
        && data.endMonth   is int && data.endMonth   >= 1 && data.endMonth   <= 12
        && data.endMonth >= data.startMonth;
    }

    match /users/{userId} {
      // Users can read/write their own profile
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Admins can read and write any user document
      allow read, write: if isAdmin();
      // Any authenticated user can read any user document
      // (scoping to own agents is enforced at the application layer)
      allow read: if request.auth != null;
      // Allow unauthenticated reads for device ID duplicate check during registration
      allow list: if true;
      // Any authenticated user can link an unlinked agent to themselves:
      // - target must be an AGENT
      // - aggregatorId must currently be absent, null, or empty
      // - written aggregatorId must equal the caller's own UID
      // - only the aggregatorId field may change
      allow update: if request.auth != null &&
        resource.data.role == 'AGENT' &&
        (!('aggregatorId' in resource.data) || resource.data.aggregatorId == null || resource.data.aggregatorId == '') &&
        request.resource.data.aggregatorId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aggregatorId']);
    }

    match /enrollments/{docId} {
      // Agents can create their own enrollments
      allow create: if request.auth != null &&
        request.resource.data.agentId == request.auth.uid;
      // Anyone authenticated can read
      allow read, list: if request.auth != null;
      // Only admins can delete or update enrollment records
      allow delete, update: if isAdmin();
    }

    match /enrollmentLogs/{docId} {
      // Only admins can create or update enrollment log entries, and only with valid schema
      allow create, update: if isAdmin() && isValidEnrollmentLog(request.resource.data);
      // Only admins can delete enrollment log entries
      allow delete:         if isAdmin();
      // Any authenticated user can read enrollment log entries
      // (scoping to own agents is enforced at the application layer)
      allow read, list:     if request.auth != null;
    }

    match /counters/{docId} {
      // Only authenticated users can read/write counters (for ID generation)
      allow read, write: if request.auth != null;
    }

    match /settings/{docId} {
      // Anyone can read settings (needed for invite code check during registration)
      allow read: if true;
      // Only admins can write settings
      allow write: if isAdmin();
    }
  }
}
